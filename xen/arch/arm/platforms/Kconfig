choice
	prompt "Platform Support" if MMU
	default ALL_PLAT
	help
	  Choose which hardware platform to enable in Xen.

	  If unsure, choose ALL_PLAT.

config ALL_PLAT
	bool "All Platforms"
	help
	  Enable support for all available hardware platforms. It doesn't
	  automatically select any of the related drivers.

config APPLE
	bool "Apple Silicon (M1/M2/M3) support"
	depends on ARM_64
	select GICV3
	help
	  Enable support for running Xen natively on Apple Silicon (M1/M2/M3)
	  with an Asahi Linux dom0.

	  This is work in progress: it currently provides the platform stub and
	  s5l early-console plumbing.  The Apple Interrupt Controller (AIC),
	  timer-over-FIQ, VHE (E2H=1) execution, spin-table SMP bring-up and DART
	  handling are not yet implemented.  See plans/asahi/ for the design.

	  GICV3 is selected because guests (including dom0) are presented with a
	  virtual GICv3 backed by the GICv3 CPU system-register interface that
	  Apple cores implement, even though the physical interrupt controller is
	  the AIC.

config APPLE_VZ
	bool "Apple Virtualization.framework generic platform"
	depends on ARM_64
	select GICV3
	select GICV2M
	help
	  Enable support for running Xen as a nested hypervisor inside a macOS
	  Virtualization.framework VM on Apple Silicon, with nested
	  virtualisation enabled so that the guest is entered at EL2.

	  This is a different machine from the bare-metal Apple Silicon support
	  (CONFIG_APPLE): the synthesised platform has a GICv3 rather than an
	  AIC, PSCI CPU bring-up, and no IOMMU, so Xen's generic arm64 paths
	  apply almost unchanged.  What it does not have is any UART, so Xen
	  boots with no console of its own; see
	  plans/asahi/11-virtualization-framework.md.

	  GICV2M is selected because the platform's only MSI controller is a
	  GICv2m frame, and with no usable INTx routing it is the only way the
	  hardware domain can get an interrupt out of a virtio-pci device.

config QEMU
	bool "QEMU aarch virt machine support"
	depends on ARM_64
	select GICV3
	select HAS_PL011
	help
	  Enable all the required drivers for QEMU aarch64 virt emulated
	  machine.

config RCAR3
	bool "Renesas R-Car Gen3 support"
	depends on ARM_64
	select HAS_SCIF
	select IPMMU_VMSA
	help
	  Enable support for Renesas R-Car Generation 3 SoCs (H3, M3, etc.).
	  Includes all required drivers and platform-specific features.

config RCAR4
	bool "Renesas R-Car Gen4 support"
	depends on ARM_64
	select GICV3
	select HAS_SCIF
	select HAS_ITS
	select IPMMU_VMSA
	help
	  Enable support for Renesas R-Car Generation 4 SoCs (V4H, V4M, etc.).
	  Includes all required drivers and platform-specific features.

config MPSOC
	bool "Xilinx Ultrascale+ MPSoC support"
	depends on ARM_64
	select HAS_CADENCE_UART
	select ARM_SMMU
	help
	  Enable all the required drivers for Xilinx Ultrascale+ MPSoC

config S32G3
	bool "NXP S32G3 Processors support"
	depends on ARM_64
	select HAS_LINFLEX
	select SCMI_SMC
	help
	  Enable all the required drivers for NXP S32G3 Processors Family

config NO_PLAT
	bool "No Platforms"
	help
	  Do not enable specific support for any platform.

endchoice

config ALL64_PLAT
	bool
	default (ALL_PLAT && ARM_64)

config ALL32_PLAT
	bool
	default (ALL_PLAT && ARM_32)

config APPLE_PLATFORM
	bool
	default (ALL64_PLAT || APPLE)

config APPLE_AIC
	bool "Apple Interrupt Controller (AIC) driver"
	default APPLE_PLATFORM
	depends on ARM_64
	help
	  Physical-layer driver for the Apple Interrupt Controller (AIC v1/v2/v3)
	  found on Apple Silicon.  Work in progress; see plans/asahi/.

config APPLE_VZ_PLATFORM
	bool
	default (ALL64_PLAT || APPLE_VZ)

config MPSOC_PLATFORM
	bool
	default (ALL64_PLAT || MPSOC)
